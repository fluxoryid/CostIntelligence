{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costintelligence",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
